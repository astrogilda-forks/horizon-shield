      "id": "E3",
      "layer": "execution",
      "applied": true,
      "statement": "the receipt hash-references the grant and comes from the executor the grant authorized"
    },
    {
      "id": "AB",
      "layer": "execution",
      "applied": true,
      "statement": "an action_binding, when carried, recomputes from the signed action under the named canonicalization (musubi-canonical-v0); it is derived, outside the preimage, and adds no trust; one that does not recompute refuses the record"
    },
    {
      "id": "PF",
      "layer": "preflight",
      "applied": false,
      "statement": "the declared pre-execution action equals the caller's grant, from the authorized executor, in the window"
